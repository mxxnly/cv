# ========== DJANGO ==========
DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# In DEBUG the ports from HTTP_PORT / BACKEND_PORT_HOST are added to this list automatically.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
TIME_ZONE=Europe/Kyiv
# development | staging | production. Non-production shows the «Тестові дані» badge for placeholders.
SITE_ENV=development
# Only for staging: allow a production-style build while config/company.json still has placeholders.
ALLOW_PLACEHOLDERS=0
# Path to the company config (default: ../config/company.json next to backend/, /config/company.json in Docker).
# COMPANY_CONFIG=

# Superuser created automatically on the first start (leave empty to skip).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ========== DATABASE ==========
POSTGRES_DB=mxxnly
POSTGRES_USER=mxxnly
POSTGRES_PASSWORD=mxxnly

# ========== LOCAL DEV ==========
# Host ports: nginx gateway (http://localhost:${HTTP_PORT}), Django and Postgres for direct access.
HTTP_PORT=80
BACKEND_PORT_HOST=8000
POSTGRES_PORT_HOST=5432
# Extra hostnames allowed to open the Vite dev server (comma-separated), e.g. a phone on the LAN.
VITE_ALLOWED_HOSTS=

# ========== SPAM PROTECTION (optional) ==========
# Cloudflare Turnstile: when both are set the forms require a Turnstile token in addition to the honeypot.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ========== CONTACT FORM NOTIFICATIONS (optional) ==========
# Email: messages are always saved in the admin; these just notify you.
CONTACT_NOTIFY_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
# Telegram: create a bot via @BotFather, get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ========== PRODUCTION ==========
# DOMAIN=example.com
# ACME_EMAIL=you@example.com
# REGISTRY=ghcr.io/mxxnly
# IMAGE_TAG=latest
# DEBUG=0
# SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SITE_ENV=production
# Behind Cloudflare proxy: trust its ranges so the real client IP reaches Django (see README → Деплой).
# TRUSTED_PROXY_IPS=173.245.48.0/20,103.21.244.0/22,...
# POSTGRES_PASSWORD=<strong random password>
# DJANGO_SUPERUSER_PASSWORD=<strong random password>
