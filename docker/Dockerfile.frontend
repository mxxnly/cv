# syntax=docker/dockerfile:1

# ========== DEPENDENCIES ==========
FROM node:24-alpine AS dependencies

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# ========== DEVELOPMENT ==========
FROM dependencies AS development

COPY frontend/ .
COPY config/ /config/

ENV VITE_PORT=8080
EXPOSE 8080

CMD ["npm", "run", "dev"]

# ========== BUILD ==========
FROM dependencies AS build

COPY frontend/ .
COPY config/ /config/
# NODE_ENV=production makes the build fail while config/company.json has placeholders
# (ALLOW_PLACEHOLDERS=1 only for staging).
ARG ALLOW_PLACEHOLDERS=0
ENV NODE_ENV=production ALLOW_PLACEHOLDERS=$ALLOW_PLACEHOLDERS
RUN npm run build

# ========== PRODUCTION ==========
# The SPA is plain static files: a tiny unprivileged nginx serves them on :8080.
FROM nginxinc/nginx-unprivileged:stable-alpine AS production

COPY docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
